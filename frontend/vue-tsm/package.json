    "test": "vitest run",
    "type-check": "vue-tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@eclipse-daanse/tsm": ">=0.1.0-next.1",
    "@emfts/core": ">=0.3.0-next.4",
